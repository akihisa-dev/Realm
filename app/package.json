{
  "name": "realm",
  "version": "0.20.5",
  "description": "A local macOS application for authoring fictional world maps.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "preinstall": "bash ../script/with_rust_toolchain.sh node scripts/runtime-policy.mjs",
    "dependencies:check": "node scripts/check-installed-dependencies.mjs",
    "start": "bash ../script/with_rust_toolchain.sh pnpm run start:inner",
    "start:inner": "pnpm dependencies:check && tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build:web": "pnpm dependencies:check && vite build",
    "build:mac": "bash ../script/with_rust_toolchain.sh pnpm run build:mac:inner",
    "build:mac:inner": "pnpm dependencies:check && tauri build --target aarch64-apple-darwin --bundles app && node scripts/build-macos-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rust:fmt:check": "bash ../script/with_rust_toolchain.sh cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "bash ../script/with_rust_toolchain.sh cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "bash ../script/with_rust_toolchain.sh cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "rust:toolchain:test": "bash ../script/rust_toolchain.test.sh",
    "runtime:check": "bash ../script/with_rust_toolchain.sh node scripts/runtime-policy.mjs",
    "skills:check": "node scripts/check-project-skills.mjs",
    "icon:check": "node scripts/check-icon-alpha.mjs",
    "docs:index:check": "node scripts/docs-index.mjs --check",
    "architecture:check": "node scripts/architecture-check.mjs",
    "version:next": "node scripts/version-policy.mjs next",
    "version:check": "node scripts/version-policy.mjs check-range",
    "version:check-staged": "node scripts/version-policy.mjs check-staged",
    "licenses:check": "bash ../script/with_rust_toolchain.sh node scripts/license-check.mjs",
    "sbom:generate": "bash ../script/with_rust_toolchain.sh node scripts/generate-sbom.mjs",
    "sbom:check": "bash ../script/with_rust_toolchain.sh node scripts/generate-sbom.mjs --check",
    "security:audit": "pnpm audit --prod --audit-level high && bash ../script/with_rust_toolchain.sh cargo deny --manifest-path src-tauri/Cargo.toml --locked check advisories",
    "security:audit:strict": "pnpm audit --prod --audit-level low && bash ../script/with_rust_toolchain.sh cargo deny --manifest-path src-tauri/Cargo.toml --locked check advisories",
    "package:check": "node scripts/check-package-artifacts.mjs",
    "release:assets": "node scripts/prepare-release-assets.mjs",
    "verify": "pnpm dependencies:check && pnpm runtime:check && pnpm typecheck && pnpm test:coverage && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "verify:full": "pnpm verify && pnpm skills:check && pnpm docs:index:check && pnpm architecture:check && pnpm icon:check && pnpm licenses:check && pnpm sbom:check && pnpm build:web",
    "verify:ci": "pnpm verify:full && pnpm security:audit",
    "verify:local:push": "pnpm install --frozen-lockfile && pnpm verify:full && pnpm security:audit:strict && git -C .. diff --check && ../.githooks/secret-guard.sh --self-test",
    "verify:local:release": "pnpm verify:local:push && pnpm build:mac && pnpm package:check && pnpm release:assets"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "ol": "10.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
