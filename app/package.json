{
  "name": "realm",
  "version": "0.53.0",
  "description": "A local macOS application for authoring fictional world maps.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "preinstall": "bash ../script/with_node_runtime.sh pnpm run preinstall:inner",
    "preinstall:inner": "node scripts/runtime-policy.mjs",
    "dependencies:check": "node scripts/check-installed-dependencies.mjs",
    "prestart": "node scripts/build-native-storage-tools.mjs",
    "start": "electron-forge start",
    "start:mac": "electron-forge start",
    "dev:web": "vite --config vite.renderer.config.ts --host 127.0.0.1 --port 1420",
    "build:web": "pnpm dependencies:check && vite build --config vite.renderer.config.ts",
    "build:mac": "node scripts/run-forge-build.mjs make",
    "package": "node scripts/run-forge-build.mjs package",
    "package:mac": "node scripts/run-forge-build.mjs package",
    "make": "node scripts/run-forge-build.mjs make",
    "make:mac": "node scripts/run-forge-build.mjs make",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-native-storage-tools.mjs",
    "test": "vitest run",
    "pretest:node": "node scripts/build-native-storage-tools.mjs",
    "test:node": "vitest run --project node",
    "pretest:coverage": "node scripts/build-native-storage-tools.mjs",
    "test:renderer": "vitest run --project renderer",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "runtime:check": "bash ../script/with_node_runtime.sh pnpm run runtime:check:inner",
    "runtime:check:inner": "node scripts/runtime-policy.mjs",
    "node:runtime:test": "bash ../script/node_runtime.test.sh",
    "secret:guard:test": "sh ../.githooks/secret-guard.sh --self-test",
    "skills:check": "node scripts/check-project-skills.mjs",
    "docs:index:check": "node scripts/docs-index.mjs --check",
    "architecture:check": "node scripts/architecture-check.mjs",
    "source:size": "node scripts/source-size-report.mjs",
    "test:inventory": "node scripts/test-inventory.mjs",
    "performance:storage": "node scripts/storage-performance-report.mjs",
    "renderer:production:check": "node scripts/renderer-production-check.mjs",
    "icon:check": "node scripts/check-icon-alpha.mjs",
    "smoke:electron": "node scripts/electron-smoke.mjs development",
    "smoke:package": "node scripts/electron-smoke.mjs package",
    "version:next": "node scripts/version-policy.mjs next",
    "version:check": "node scripts/version-policy.mjs check-range",
    "version:check-staged": "node scripts/version-policy.mjs check-staged",
    "licenses:check": "node scripts/license-check.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:audit:strict": "pnpm audit --prod --audit-level low",
    "package:check": "node scripts/check-package-artifacts.mjs",
    "release:assets": "node scripts/prepare-release-assets.mjs",
    "verify": "bash ../script/with_node_runtime.sh pnpm run verify:inner",
    "verify:inner": "pnpm dependencies:check && pnpm runtime:check && pnpm typecheck && pnpm test:coverage && pnpm secret:guard:test",
    "verify:full": "bash ../script/with_node_runtime.sh pnpm run verify:full:inner",
    "verify:full:inner": "pnpm run verify:inner && pnpm test:node && pnpm test:renderer && pnpm skills:check && pnpm docs:index:check && pnpm architecture:check && pnpm source:size && pnpm test:inventory && pnpm performance:storage && pnpm licenses:check && pnpm sbom:check && pnpm build:web && pnpm renderer:production:check && pnpm node:runtime:test",
    "verify:ci": "bash ../script/with_node_runtime.sh pnpm run verify:ci:inner",
    "verify:ci:inner": "pnpm run verify:full:inner && pnpm security:audit",
    "verify:local:push": "bash ../script/with_node_runtime.sh pnpm run verify:local:push:inner",
    "verify:local:push:inner": "pnpm install --frozen-lockfile && pnpm run verify:full:inner && pnpm security:audit:strict && git -C .. diff --check",
    "verify:local:release": "bash ../script/with_node_runtime.sh pnpm run verify:local:release:inner",
    "verify:local:release:inner": "pnpm run verify:local:push:inner && pnpm build:mac && pnpm package:check && pnpm smoke:package && pnpm release:assets"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "ol": "10.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/asar": "3.4.1",
    "electron": "43.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
